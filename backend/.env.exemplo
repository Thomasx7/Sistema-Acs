# Banco PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO

# Segredo da aplicacao (substitua por um valor aleatorio no seu ambiente)
SECRET_KEY=troque-por-uma-chave-aleatoria
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria

# Configuracao SMTP (substitua pelos dados do seu servidor de e-mail)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@example.com
MAIL_PASSWORD=senha-de-aplicativo-de-exemplo
MAIL_USE_TLS=True
