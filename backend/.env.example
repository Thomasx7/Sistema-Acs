# Banco PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO

# Segredo da aplicacao (substitua por um valor aleatorio no seu ambiente)
SECRET_KEY=troque-por-uma-chave-aleatoria
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria

# Desenvolvimento local; para produção, consulte docs/deploy.md.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LIBRARY_UPLOAD_DIR=./uploads/library

# local para desenvolvimento; s3 para uploads privados na Neon.
UPLOAD_STORAGE=local
S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Configuracao SMTP (substitua pelos dados do seu servidor de e-mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@example.com
MAIL_PASSWORD=senha-de-aplicativo-de-exemplo
MAIL_USE_TLS=True


