# Porta do PostgreSQL no computador; dentro do Docker ele usa 5432.
DB_PORT=5434
POSTGRES_USER=sistema_acs
POSTGRES_PASSWORD=senha_local_de_desenvolvimento
POSTGRES_DB=sistema_acs

# Conta exclusiva para desenvolvimento.
SEED_ADMIN=true
ADMIN_EMAIL=sistema.acs.oficial@gmail.com
ADMIN_SENHA=Admin@123

# O Compose define DATABASE_URL para usar o serviço db.
# DATABASE_URL=
SECRET_KEY=troque-por-uma-chave-local
JWT_SECRET_KEY=troque-por-outra-chave-local
FRONTEND_URL=http://localhost:5173
RESET_SENHA_EXPIRA_MINUTOS=30

# Deixe os campos de e-mail vazios se não for configurar SMTP.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_DEFAULT_SENDER=
